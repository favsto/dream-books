<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Visual values are defined once here (see .claude/rules/wpf-ui.md). Minimal for the prototype. -->
    <sys:Double x:Key="TouchTarget">40</sys:Double>
    <sys:Double x:Key="PanelWidth">280</sys:Double>
    <sys:Double x:Key="ProgressBarHeight">4</sys:Double>
    <Thickness x:Key="Gap">0,4,0,0</Thickness>
    <Thickness x:Key="SectionGap">0,12,0,0</Thickness>

    <!-- Eraser cursor (FR-32): system accent colour, fill at 20% opacity, 1 DIP outline. -->
    <SolidColorBrush x:Key="EraserCursorFill" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" Opacity="0.2" />
    <SolidColorBrush x:Key="EraserCursorOutline" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
    <sys:Double x:Key="EraserCursorOutlineThickness">1</sys:Double>

    <!-- Document view (phase 3a): neutral backdrop around the pages; a page not rendered yet is white paper that
         fades in lightly (instant when Windows animations are off, NFR-03, NFR-32). -->
    <SolidColorBrush x:Key="PageBackdropBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="PagePlaceholderBrush" Color="White" />
    <Duration x:Key="PageFadeInDuration">0:0:0.15</Duration>
    <sys:Double x:Key="PageFadeInFromOpacity">0.6</sys:Double>

    <!-- Scroll rail (UI-07, design B): a 40 px touch strip on the right edge with an 8 px bar and a 34 px knob, one large
         page preview beside the knob while scrubbing, and the page indicator; all fade in 180 ms and out 200 ms after
         1.5 s idle, ease-out (instant when Windows animations are off, NFR-32). No marks yet (3b). -->
    <sys:TimeSpan x:Key="RailFadeInDuration">0:0:0.18</sys:TimeSpan>
    <sys:TimeSpan x:Key="RailFadeOutDuration">0:0:0.2</sys:TimeSpan>
    <sys:TimeSpan x:Key="RailIdleDelay">0:0:1.5</sys:TimeSpan>
    <sys:Double x:Key="RailTouchWidth">40</sys:Double>
    <sys:Double x:Key="RailBarWidth">8</sys:Double>
    <sys:Double x:Key="RailKnobWidth">14</sys:Double>
    <sys:Double x:Key="RailKnobHeight">34</sys:Double>
    <CornerRadius x:Key="RailBarCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RailKnobCornerRadius">7</CornerRadius>
    <Thickness x:Key="RailTrackMargin">0,12,0,12</Thickness>
    <SolidColorBrush x:Key="RailTrackBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" Opacity="0.55" />
    <SolidColorBrush x:Key="RailKnobBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
    <sys:Double x:Key="RailPreviewWidth">300</sys:Double>
    <Thickness x:Key="RailPreviewMargin">0,0,48,0</Thickness>
    <Thickness x:Key="RailPreviewPadding">6</Thickness>
    <CornerRadius x:Key="RailPreviewCornerRadius">10</CornerRadius>
    <SolidColorBrush x:Key="RailPreviewBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" Opacity="0.92" />
    <DropShadowEffect x:Key="RailPreviewShadow" BlurRadius="14" ShadowDepth="4" Opacity="0.3" />
    <!-- With Windows "Transparency effects" off (NFR-32): the same colours, opaque, and no shadow. -->
    <SolidColorBrush x:Key="RailTrackBrushOpaque" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="RailPreviewBackgroundBrushOpaque" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Thickness x:Key="RailIndicatorMargin">0,0,44,12</Thickness>
    <sys:Double x:Key="GoToPageFieldWidth">80</sys:Double>

    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource TouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource SectionGap}" />
    </Style>
</ResourceDictionary>
