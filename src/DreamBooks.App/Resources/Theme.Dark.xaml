<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colour tokens (section 3, materials): the same keys as Theme.Light.xaml (see there). Shadows are a
         little stronger so they still read on the dark backdrop. -->
    <Color x:Key="ThemeTextColor">#FFFFFF</Color>
    <Color x:Key="ThemePanelColor">#2C2C2C</Color>
    <Color x:Key="ThemeControlDarkColor">#7A7A7A</Color>
    <Color x:Key="ThemeShadowColor">#000000</Color>

    <!-- Window: Mica (FluentWindow); with Windows "Transparency effects" off a solid brush instead (NFR-32). -->
    <SolidColorBrush x:Key="WindowBackgroundOpaqueBrush" Color="#202020" />

    <!-- Around the pages: a dark neutral grey laid over the Mica (opaque with transparency effects off, NFR-32).
         Pages: a soft shadow (blur 24 px), square corners. -->
    <Color x:Key="PageBackdropColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="PageBackdropBrush" Color="{StaticResource PageBackdropColor}" Opacity="0.6" />
    <SolidColorBrush x:Key="PageBackdropBrushOpaque" Color="{StaticResource PageBackdropColor}" />
    <DropShadowEffect x:Key="PageShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="{StaticResource ThemeShadowColor}" />

    <!-- Floating panels: tinted translucency (65%), opaque with transparency effects off (NFR-32); two shadows. -->
    <SolidColorBrush x:Key="PanelTintBrush" Color="{StaticResource ThemePanelColor}" Opacity="0.65" />
    <SolidColorBrush x:Key="PanelTintBrushOpaque" Color="{StaticResource ThemePanelColor}" />
    <DropShadowEffect x:Key="PanelDiffuseShadow" BlurRadius="32" ShadowDepth="4" Opacity="0.24" Color="{StaticResource ThemeShadowColor}" />
    <DropShadowEffect x:Key="PanelContactShadow" BlurRadius="4" ShadowDepth="1" Opacity="0.16" Color="{StaticResource ThemeShadowColor}" />
    <!-- One of the two layers of a floating surface (each carries one shadow): 41% each, 65% together. -->
    <SolidColorBrush x:Key="PanelLayerBrush" Color="{StaticResource ThemePanelColor}" Opacity="0.41" />

    <!-- Toolbar and flyouts (UI-02): see Theme.Light.xaml. -->
    <SolidColorBrush x:Key="ToolbarHoverBrush" Color="{StaticResource ThemeTextColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="ToolbarPressedBrush" Color="{StaticResource ThemeTextColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="{StaticResource ThemeTextColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="ToolIndicatorBrush" Color="{DynamicResource SystemAccentColorPrimary}" Opacity="0.3" />
    <SolidColorBrush x:Key="ToolIndicatorBarBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="ToolActiveForegroundBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="FlyoutHeaderBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="SwatchRingBrush" Color="{StaticResource ThemeTextColor}" />
    <SolidColorBrush x:Key="SwatchOutlineBrush" Color="{StaticResource ThemeTextColor}" Opacity="0.25" />

    <!-- Eraser cursor (FR-32): the accent colour, fill at 20% opacity, 1 DIP outline. -->
    <SolidColorBrush x:Key="EraserCursorFill" Color="{DynamicResource SystemAccentColorPrimary}" Opacity="0.2" />
    <SolidColorBrush x:Key="EraserCursorOutline" Color="{DynamicResource SystemAccentColorPrimary}" />

    <!-- Scroll rail (UI-07). -->
    <SolidColorBrush x:Key="RailTrackBrush" Color="{StaticResource ThemeControlDarkColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="RailTrackBrushOpaque" Color="{StaticResource ThemeControlDarkColor}" />
    <SolidColorBrush x:Key="RailKnobBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="RailPreviewBackgroundBrush" Color="{StaticResource ThemePanelColor}" Opacity="0.92" />
    <SolidColorBrush x:Key="RailPreviewBackgroundBrushOpaque" Color="{StaticResource ThemePanelColor}" />
    <DropShadowEffect x:Key="RailPreviewShadow" BlurRadius="14" ShadowDepth="4" Opacity="0.45" Color="{StaticResource ThemeShadowColor}" />
    <SolidColorBrush x:Key="RailMarkTickBrush" Color="{StaticResource ThemeTextColor}" Opacity="0.75" />
    <SolidColorBrush x:Key="RailMarkTickBrushOpaque" Color="{StaticResource ThemeTextColor}" />

    <!-- Left-edge panel (UI-04). -->
    <SolidColorBrush x:Key="EdgePanelBackgroundBrush" Color="{StaticResource ThemePanelColor}" Opacity="0.92" />
    <SolidColorBrush x:Key="EdgePanelBackgroundBrushOpaque" Color="{StaticResource ThemePanelColor}" />
    <DropShadowEffect x:Key="EdgePanelShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="{StaticResource ThemeShadowColor}" />
    <SolidColorBrush x:Key="EdgePanelTabIndicatorBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource ThemeTextColor}" />

    <!-- Marks list and Pages tab (FR-103). -->
    <SolidColorBrush x:Key="MarkThumbnailBorderBrush" Color="{StaticResource ThemeControlDarkColor}" />
    <SolidColorBrush x:Key="PagesThumbnailBorderBrush" Color="{StaticResource ThemeControlDarkColor}" />
    <SolidColorBrush x:Key="PagesCurrentRingBrush" Color="{DynamicResource SystemAccentColorPrimary}" />

    <!-- The save progress line under the title bar (FR-89): the accent colour. -->
    <SolidColorBrush x:Key="SaveProgressBarBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
</ResourceDictionary>
