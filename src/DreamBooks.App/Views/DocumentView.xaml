<UserControl x:Class="DreamBooks.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DreamBooks.App.Views">
    <!-- The continuous document (FR-05): fingers pan and pinch (manipulation), Ctrl+wheel zooms, a one-finger double
         tap toggles fit width / 200% (FR-06, FR-07); the pen only inks (FR-30). No layout rounding: the pages sit
         exactly where DocumentLayout puts them, so zoom stays anchored to the sub-pixel. The scroll bars are hidden
         (the thin rail of UI-07 replaces them); wheel and keyboard still scroll. -->
    <ScrollViewer x:Name="Viewport"
                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                  CanContentScroll="False"
                  PanningMode="None" IsManipulationEnabled="True" UseLayoutRounding="False"
                  Background="{DynamicResource PageBackdropBrush}"
                  Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                  Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False"
                  ScrollChanged="OnScrollChanged"
                  ManipulationStarting="OnManipulationStarting"
                  ManipulationDelta="OnManipulationDelta"
                  ManipulationBoundaryFeedback="OnManipulationBoundaryFeedback"
                  PreviewMouseWheel="OnPreviewMouseWheel"
                  PreviewTouchDown="OnPreviewTouchDown"
                  PreviewTouchUp="OnPreviewTouchUp"
                  LostTouchCapture="OnTouchEnded"
                  TouchLeave="OnTouchEnded">
        <views:VirtualPagePanel x:Name="Pages" />
    </ScrollViewer>
</UserControl>
