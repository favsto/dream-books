<UserControl x:Class="DreamBooks.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DreamBooks.App.Views">
    <!-- The host routes presses by position: fingers and the mouse on the rail's knob (a wider zone), strip or
         indicator go to the rail; the pen only grabs the knob (elsewhere it inks on the page under it). Any press
         outside the open page field closes it. -->
    <Grid x:Name="Host"
          PreviewMouseLeftButtonDown="OnHostMouseDown" PreviewMouseMove="OnHostMouseMove"
          PreviewMouseLeftButtonUp="OnHostMouseUp" LostMouseCapture="OnHostLostMouseCapture" MouseLeave="OnHostMouseLeave"
          PreviewTouchDown="OnHostTouchDown" PreviewTouchMove="OnHostTouchMove" PreviewTouchUp="OnHostTouchUp"
          LostTouchCapture="OnHostLostTouchCapture" PreviewStylusDown="OnHostStylusDown"
          PreviewStylusInRange="OnHostStylusInRange" PreviewStylusMove="OnHostStylusMove"
          PreviewStylusUp="OnHostStylusUp" LostStylusCapture="OnHostLostStylusCapture">
        <!-- The continuous document (FR-05): fingers pan and pinch (manipulation; a flicked pan glides on per frame,
             FlingSettings), Ctrl+wheel zooms, Shift+wheel pans
             sideways (Ctrl/Shift+wheel works over the rail too), a one-finger double tap toggles fit width / 200% (FR-06, FR-07); the pen only inks (FR-30). No
             layout rounding inside: the scroll offsets and geometry stay exact (zoom anchored to the sub-pixel) and
             VirtualPagePanel snaps each page itself to whole device pixels on screen, so the bitmap maps 1:1 (the window
             rounds its own layout, so this viewer's origin is on a whole pixel too). The scroll bars are hidden: the
             rail (UI-07) replaces them; the wheel scrolls, and the navigation keys go through the view model. -->
        <ScrollViewer x:Name="Viewport"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False"
                      PanningMode="None" IsManipulationEnabled="True" UseLayoutRounding="False"
                      Background="{DynamicResource PageBackdropBrush}"
                      Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                      Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False"
                      ScrollChanged="OnScrollChanged"
                      ManipulationStarting="OnManipulationStarting"
                      ManipulationDelta="OnManipulationDelta"
                      ManipulationInertiaStarting="OnManipulationInertiaStarting"
                      ManipulationBoundaryFeedback="OnManipulationBoundaryFeedback"
                      PreviewMouseWheel="OnPreviewMouseWheel"
                      PreviewTouchDown="OnPreviewTouchDown"
                      PreviewTouchUp="OnPreviewTouchUp"
                      LostTouchCapture="OnTouchEnded"
                      TouchLeave="OnTouchEnded">
            <views:VirtualPagePanel x:Name="Pages" />
        </ScrollViewer>

        <!-- The fading scroll rail over the right edge: it never hit-tests (only its open page field does). -->
        <views:ScrollRail x:Name="Rail" />
    </Grid>
</UserControl>
