<UserControl x:Class="DreamBooks.App.Views.PagesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DreamBooks.App.Resources"
             xmlns:views="clr-namespace:DreamBooks.App.Views"
             Focusable="False" IsTabStop="False">
    <!-- The Pages tab (FR-103, UI-04) over a PagesViewModel: one virtualised row per page, the thumbnail (page bitmap with
         the ink over it, PageThumbnail) sized by the page's proportions and its number under it; the current page is
         ringed, marks and notes show a tick in the rail's colours on the left. A tap or Enter goes to the page (Back
         history once per visit) and the panel stays open; arrows move between rows. -->
    <ListBox x:Name="List" ItemsSource="{Binding Pages}" Margin="{StaticResource Gap}"
             Background="Transparent" BorderThickness="0"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Item"
             VirtualizingPanel.CacheLength="2,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly"
             ScrollViewer.CanContentScroll="True"
             AutomationProperties.Name="{x:Static res:Strings.PagesListLabel}"
             PreviewMouseLeftButtonDown="OnListPress" PreviewKeyDown="OnListKeyDown"
             ManipulationBoundaryFeedback="OnListBoundaryFeedback">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
                <Setter Property="Padding" Value="{StaticResource PagesRowPadding}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowRelease" />
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource PagesTickColumnWidth}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource PagesTickColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="{StaticResource PagesTickMargin}" IsHitTestVisible="False">
                        <Rectangle x:Name="NoteTick" Width="{StaticResource PagesTickWidth}" Height="{StaticResource PagesTickHeight}"
                                   Fill="{StaticResource RailNoteTickBrushOpaque}" Margin="{StaticResource PagesTickGap}"
                                   IsHitTestVisible="False">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Rectangle x:Name="MarkTick" Width="{StaticResource PagesTickWidth}" Height="{StaticResource PagesTickHeight}"
                                   Fill="{DynamicResource RailMarkTickBrushOpaque}" IsHitTestVisible="False">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMarks}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <!-- The ring is always there (same size), coloured only on the current page: no jump in the list. -->
                        <Border x:Name="Ring" BorderThickness="{StaticResource PagesCurrentRingThickness}"
                                CornerRadius="{StaticResource PagesCurrentRingCornerRadius}" Padding="{StaticResource PagesCurrentRingPadding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PagesCurrentRingBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <views:PageThumbnail Page="{Binding}" />
                        </Border>
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="{StaticResource PagesNumberMargin}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
