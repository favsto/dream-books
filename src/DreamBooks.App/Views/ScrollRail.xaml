<UserControl x:Class="DreamBooks.App.Views.ScrollRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DreamBooks.App.Resources"
             xmlns:local="clr-namespace:DreamBooks.App.Views"
             Focusable="False" IsTabStop="False" Opacity="0"
             AutomationProperties.Name="{x:Static res:Strings.RailLabel}">
    <!-- The scroll rail (UI-07, design B) over the document's right edge. Its visuals never hit-test, so the pen
         reaches the page under them and inks (FR-30), except on the knob: while the rail is shown the pen grabs it
         (KnobGrip). Fingers and the mouse reach the knob (a wider zone), the strip and the indicator through
         DocumentView, which routes them by position (ZoneAt). Only the page field, while open, takes keyboard focus. -->
    <Grid>
        <Grid x:Name="Visuals" IsHitTestVisible="False">
            <!-- One large preview beside the knob while scrubbing: the page number and a light render (white until
                 it arrives). -->
            <Border x:Name="PreviewBubble" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="{StaticResource RailPreviewWidth}" Margin="{StaticResource RailPreviewMargin}"
                    Padding="{StaticResource RailPreviewPadding}" CornerRadius="{StaticResource RailPreviewCornerRadius}"
                    Background="{StaticResource RailPreviewBackgroundBrush}" Effect="{StaticResource RailPreviewShadow}"
                    IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="OnBubbleSizeChanged">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BubbleOffset" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid>
                        <Rectangle x:Name="PreviewPlaceholder" Fill="{StaticResource PagePlaceholderBrush}" />
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               AutomationProperties.Name="{x:Static res:Strings.RailPreviewLabel}" />
                    </Grid>
                    <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" Margin="{StaticResource Gap}" />
                </StackPanel>
            </Border>

            <!-- The touch strip: a tap on the track jumps, a drag scrubs. -->
            <Border x:Name="Strip" HorizontalAlignment="Right" Width="{StaticResource RailTouchWidth}" Focusable="False">
                <Grid x:Name="Track" Margin="{StaticResource RailTrackMargin}">
                    <Border x:Name="TrackBar" Width="{StaticResource RailBarWidth}" HorizontalAlignment="Center"
                            CornerRadius="{StaticResource RailBarCornerRadius}" Background="{StaticResource RailTrackBrush}" />
                    <!-- The notes' ticks (FR-101), beside the marks' in another colour, then the marks' ticks on top: over
                         the bar, under the knob; decorative, never hit-tested. -->
                    <local:RailTickLayer x:Name="NoteTicks" Fill="{StaticResource RailNoteTickBrush}"
                                         TickLength="{StaticResource RailNoteTickLength}"
                                         TickThickness="{StaticResource RailNoteTickThickness}"
                                         TickOffset="{StaticResource RailNoteTickOffset}" />
                    <local:RailTickLayer x:Name="Ticks" Fill="{StaticResource RailMarkTickBrush}"
                                         TickLength="{StaticResource RailMarkTickLength}"
                                         TickThickness="{StaticResource RailMarkTickThickness}" />
                    <Border x:Name="Knob" Width="{StaticResource RailKnobWidth}" Height="{StaticResource RailKnobHeight}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            CornerRadius="{StaticResource RailKnobCornerRadius}" Background="{StaticResource RailKnobBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="KnobOffset" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <!-- "12 / 48 · 125%": a finger or mouse tap opens the page field (FR-09); a button for UI Automation. -->
            <Button x:Name="IndicatorButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="{StaticResource RailIndicatorMargin}" Content="{Binding Viewport.IndicatorText}"
                    Focusable="False" Click="OnIndicatorClick"
                    AutomationProperties.Name="{x:Static res:Strings.PageIndicatorLabel}" />
        </Grid>

        <!-- The only part of the rail the pen can take: the knob plus a small slop, while the rail is shown (the grip
             follows the knob; the canvas itself has no background and never hit-tests). -->
        <Canvas x:Name="GripLayer">
            <local:RailKnobGrip x:Name="KnobGrip" IsHitTestVisible="False" />
        </Canvas>

        <!-- The page field in the indicator's place; Enter goes, Esc cancels, any press outside it closes it. -->
        <TextBox x:Name="GoToPageBox" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="{StaticResource RailIndicatorMargin}" Visibility="Collapsed" InputScope="Number"
                 MinWidth="{StaticResource GoToPageFieldWidth}" MinHeight="{StaticResource TouchTarget}"
                 VerticalContentAlignment="Center"
                 ToolTip="{x:Static res:Strings.GoToPageHint}"
                 AutomationProperties.Name="{x:Static res:Strings.GoToPageIndicatorField}"
                 AutomationProperties.HelpText="{x:Static res:Strings.GoToPageHint}"
                 PreviewKeyDown="OnGoToPageKeyDown" LostKeyboardFocus="OnGoToPageLostFocus" />
    </Grid>
</UserControl>
