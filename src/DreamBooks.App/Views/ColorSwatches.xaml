<UserControl x:Class="DreamBooks.App.Views.ColorSwatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DreamBooks.App.Views"
             Focusable="False" IsTabStop="False">
    <!-- The colour swatches (UI-02): the presets, the shared custom colours and "+" (built by the code), then the free
         colour picker that "+" opens. -->
    <StackPanel>
        <WrapPanel x:Name="SwatchPanel" />
        <views:ColorPickerPanel x:Name="Picker" Visibility="Collapsed" Margin="{StaticResource Gap}" />
    </StackPanel>
</UserControl>
