<Window x:Class="DreamBooks.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DreamBooks.App.Resources"
        Title="Dream Books" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight"
        Background="{StaticResource SplashBackgroundBrush}"
        AutomationProperties.Name="{x:Static res:Strings.SplashTagline}">
    <!-- The splash (4b): shown from the start of the process until the window is ready, then closed by the app. The icon,
         the name, a short tagline and an indicator that is indeterminate, or still with Windows animations off (NFR-32).
         A fixed dark look: it shows before the settings and the theme are loaded. -->
    <StackPanel Margin="{StaticResource SplashPadding}" HorizontalAlignment="Center">
        <Image Source="pack://application:,,,/DreamBooks.App;component/Assets/app-icon.png"
               Width="{StaticResource SplashIconSize}" Height="{StaticResource SplashIconSize}" />
        <TextBlock Text="Dream Books" FontSize="{StaticResource SplashTitleSize}" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="{StaticResource SplashTitleMargin}" Foreground="{StaticResource SplashTextBrush}" />
        <TextBlock Text="{x:Static res:Strings.SplashTagline}" FontSize="{StaticResource SplashTaglineSize}" HorizontalAlignment="Center"
                   Margin="{StaticResource SplashTaglineMargin}" Foreground="{StaticResource SplashSubtextBrush}" />
        <ProgressBar x:Name="Indicator" IsIndeterminate="True" Minimum="0" Maximum="1" Value="0.4"
                     Width="{StaticResource SplashIndicatorWidth}" Height="{StaticResource SplashIndicatorHeight}"
                     Margin="{StaticResource SplashIndicatorMargin}" BorderThickness="0"
                     Foreground="{StaticResource SplashAccentBrush}" Background="{StaticResource SplashSubtextBrush}" />
    </StackPanel>
</Window>
