<UserControl x:Class="DreamBooks.App.Views.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DreamBooks.App.Resources"
             xmlns:conv="clr-namespace:DreamBooks.App.Converters"
             AutomationProperties.Name="{x:Static res:Strings.ColorPicker}">
    <!-- The free colour picker (UI-02 custom palette; WPF UI 4.3 keeps its own ColorPicker internal): the saturation and
         brightness square (finger, mouse, arrow keys), the hue slider over its spectrum, the hex field, a preview of the
         colour, and Add / Cancel. -->
    <UserControl.Resources>
        <conv:InkColorToBrushConverter x:Key="ColorBrush" />
    </UserControl.Resources>
    <StackPanel x:Name="Root">
        <Grid x:Name="Square" Height="{StaticResource ColorPickerSquareHeight}" Focusable="True"
              Background="{Binding HueColor, Converter={StaticResource ColorBrush}}"
              AutomationProperties.Name="{x:Static res:Strings.ColorPickerSquare}"
              MouseLeftButtonDown="OnSquareMouseDown" MouseMove="OnSquareMouseMove" MouseLeftButtonUp="OnSquareMouseUp" KeyDown="OnSquareKeyDown">
            <Grid.Clip>
                <RectangleGeometry x:Name="SquareClip" />
            </Grid.Clip>
            <Border Background="{StaticResource ColorPickerWhiteGradient}" />
            <Border Background="{StaticResource ColorPickerBlackGradient}" />
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="Thumb" Width="{StaticResource ColorPickerThumbSize}" Height="{StaticResource ColorPickerThumbSize}"
                         Stroke="{DynamicResource SwatchRingBrush}" StrokeThickness="{StaticResource SwatchRingThickness}"
                         Fill="{Binding Color, Converter={StaticResource ColorBrush}}" />
            </Canvas>
        </Grid>
        <Border x:Name="HueStrip" Height="{StaticResource ColorPickerHueHeight}" Margin="{StaticResource Gap}"
                CornerRadius="{StaticResource InnerCornerRadius}" IsHitTestVisible="False" />
        <Slider x:Name="HueSlider" Minimum="0" Maximum="359" Value="{Binding Hue}" SmallChange="1" LargeChange="15"
                MinHeight="{StaticResource TouchTarget}"
                AutomationProperties.Name="{x:Static res:Strings.ColorPickerHue}" />
        <DockPanel Margin="{StaticResource Gap}">
            <Ellipse DockPanel.Dock="Left" Width="{StaticResource ColorPickerPreviewSize}" Height="{StaticResource ColorPickerPreviewSize}"
                     VerticalAlignment="Center" Margin="{StaticResource ColorPickerHexMargin}"
                     Stroke="{DynamicResource SwatchOutlineBrush}" StrokeThickness="{StaticResource SwatchOutlineThickness}"
                     Fill="{Binding Color, Converter={StaticResource ColorBrush}}" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{x:Static res:Strings.Cancel}" Margin="{StaticResource ColorPickerButtonMargin}"
                    Click="OnCancelClick" AutomationProperties.Name="{x:Static res:Strings.Cancel}" />
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="{x:Static res:Strings.ColorPickerConfirm}" Margin="{StaticResource ColorPickerButtonMargin}"
                    Click="OnConfirmClick" IsEnabled="{Binding IsHexValid}"
                    AutomationProperties.Name="{x:Static res:Strings.ColorPickerConfirm}" />
            <TextBox x:Name="HexField" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                     LostKeyboardFocus="OnHexFieldLostFocus" KeyDown="OnHexFieldKeyDown"
                     MinHeight="{StaticResource TouchTarget}" VerticalContentAlignment="Center"
                     ToolTip="{x:Static res:Strings.ColorPickerHexHint}"
                     AutomationProperties.Name="{x:Static res:Strings.ColorPickerHex}"
                     AutomationProperties.HelpText="{x:Static res:Strings.ColorPickerHexHint}" />
        </DockPanel>
    </StackPanel>
</UserControl>
