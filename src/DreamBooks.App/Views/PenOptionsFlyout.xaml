<UserControl x:Class="DreamBooks.App.Views.PenOptionsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DreamBooks.App.Resources"
             xmlns:conv="clr-namespace:DreamBooks.App.Converters"
             xmlns:views="clr-namespace:DreamBooks.App.Views"
             AutomationProperties.Name="{x:Static res:Strings.PenOptions}"
             Focusable="False" IsTabStop="False">
    <!-- The pen's option panel (UI-02, FR-21, FR-22, FR-25), above the toolbar: colours (8 presets, the shared custom
         palette, "+" for the free picker), the three preset widths and the width slider, the stroke preview with
         pressure, and the pressure curve. The data context is the ToolbarViewModel. -->
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </UserControl.Resources>
    <views:FloatingSurface x:Name="Surface" Width="{StaticResource FlyoutWidth}" CornerRadius="{StaticResource PanelCornerRadius}">
        <StackPanel Margin="{StaticResource FlyoutPadding}" KeyboardNavigation.TabNavigation="Cycle">
            <TextBlock Text="{x:Static res:Strings.Color}" Style="{StaticResource FlyoutHeader}" Margin="0,0,0,4" />
            <views:ColorSwatches x:Name="Swatches"
                                 Presets="{Binding Pen.Presets}" CustomColors="{Binding Pen.CustomColors}"
                                 SelectedColor="{Binding Pen.Color, Mode=OneWay}"
                                 SelectCommand="{Binding Pen.SelectColorCommand}"
                                 AddCommand="{Binding Pen.AddCustomColorCommand}"
                                 RemoveCommand="{Binding Pen.RemoveCustomColorCommand}" />

            <TextBlock Text="{x:Static res:Strings.Width}" Style="{StaticResource FlyoutHeader}" />
            <StackPanel x:Name="WidthPresetPanel" Orientation="Horizontal" />
            <Slider x:Name="WidthSlider" Minimum="{Binding Pen.MinWidthMm, Mode=OneWay}" Maximum="{Binding Pen.MaxWidthMm, Mode=OneWay}"
                    Value="{Binding Pen.WidthMm}" SmallChange="0.05" LargeChange="0.25"
                    MinHeight="{StaticResource TouchTarget}"
                    AutomationProperties.Name="{x:Static res:Strings.Width}" />
            <views:PressurePreview x:Name="Preview" Height="{StaticResource PressurePreviewHeight}"
                                   Curve="{Binding Tools.Curve}" WidthMm="{Binding Pen.WidthMm}" InkColor="{Binding Pen.Color}"
                                   AutomationProperties.Name="{x:Static res:Strings.PressurePreview}" />

            <TextBlock Text="{x:Static res:Strings.PressureCurve}" Style="{StaticResource FlyoutHeader}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{x:Static res:Strings.CurveLinear}" AutomationProperties.Name="{x:Static res:Strings.CurveLinear}"
                             IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Linear}" />
                <RadioButton Content="{x:Static res:Strings.CurveSoft}" AutomationProperties.Name="{x:Static res:Strings.CurveSoft}"
                             IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Soft}" />
                <RadioButton Content="{x:Static res:Strings.CurveFirm}" AutomationProperties.Name="{x:Static res:Strings.CurveFirm}"
                             IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Firm}" />
            </StackPanel>
        </StackPanel>
    </views:FloatingSurface>
</UserControl>
