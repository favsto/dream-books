<UserControl x:Class="DreamBooks.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DreamBooks.App.Resources"
             xmlns:views="clr-namespace:DreamBooks.App.Views"
             xmlns:vm="clr-namespace:DreamBooks.App.ViewModels"
             HorizontalAlignment="Stretch" VerticalAlignment="Top" Focusable="False" IsTabStop="False"
             MaxWidth="{StaticResource StartMaxWidth}" Margin="{StaticResource StartMargin}"
             AutomationProperties.Name="{x:Static res:Strings.StartLabel}">
    <!-- The start screen (FR-03): with no document open, "Riprendi a leggere" with the "Apri PDF…" button and the recent
         documents as cover cards (variant B of the 4b mockups). The data context is the StartViewModel. Only the button
         and the cards hit-test; each card's cover is a floating surface, so the pen rules of the other floating views
         hold (there is no page to ink on here). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhen" />
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:RecentCardViewModel}">
            <Grid Margin="{StaticResource StartCardMargin}" Width="{StaticResource StartCardWidth}">
                <Button Style="{StaticResource StartCardButtonStyle}"
                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=views:StartView}}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel>
                        <views:FloatingSurface Height="{StaticResource StartCoverHeight}"
                                               CornerRadius="{StaticResource InnerCornerRadius}">
                            <Border Background="{StaticResource PagePlaceholderBrush}" CornerRadius="{StaticResource InnerCornerRadius}"
                                    ClipToBounds="True">
                                <Image Source="{Binding Cover}" Stretch="Uniform" />
                            </Border>
                        </views:FloatingSurface>
                        <TextBlock Text="{Binding Title}" Margin="{StaticResource StartCardTextMargin}" FontWeight="SemiBold"
                                   FontSize="{StaticResource StartCardTextSize}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource GlyphBrush}" />
                        <TextBlock Margin="{StaticResource StartCardSubtextMargin}" FontSize="{StaticResource StartCardTextSize}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource FlyoutHeaderBrush}">
                            <Run Text="{Binding WhenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PageText, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Height="{StaticResource StartProgressHeight}" Margin="{StaticResource StartProgressMargin}"
                                     BorderThickness="0" Foreground="{DynamicResource ToolActiveForegroundBrush}"
                                     Background="{DynamicResource ToolbarSeparatorBrush}" />
                    </StackPanel>
                    <Button.ToolTip>
                        <TextBlock Text="{Binding Title}" />
                    </Button.ToolTip>
                </Button>
                <!-- A file that is gone: the card says so and this removes it from the list. -->
                <Button x:Name="RemoveButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource ToolbarButtonStyle}" Margin="0" Content="&#xE711;"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=views:StartView}}"
                        CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.StartRemove}"
                        AutomationProperties.Name="{x:Static res:Strings.StartRemove}"
                        Visibility="{Binding IsMissing, Converter={StaticResource ShowWhen}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="{StaticResource StartHeaderMargin}">
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Command="{Binding OpenPdfCommand}"
                    Content="{x:Static res:Strings.StartOpenPdf}" Style="{StaticResource DialogButtonStyle}"
                    AutomationProperties.Name="{x:Static res:Strings.StartOpenPdf}" />
            <TextBlock Text="{x:Static res:Strings.StartResume}" FontSize="{StaticResource StartTitleSize}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource GlyphBrush}" />
        </DockPanel>
        <ItemsControl x:Name="CardsList" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}"
                      Focusable="False" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button x:Name="MoreButton" HorizontalAlignment="Left" Command="{Binding ShowAllCommand}"
                Content="{x:Static res:Strings.StartMore}" Style="{StaticResource DialogButtonStyle}"
                AutomationProperties.Name="{x:Static res:Strings.StartAllName}"
                Visibility="{Binding ShowMore, Converter={StaticResource ShowWhen}}" />
    </StackPanel>
</UserControl>
