<Window x:Class="DreamBooks.App.MainWindow" UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DreamBooks.App.Resources"
        xmlns:ink="clr-namespace:DreamBooks.App.Ink"
        xmlns:conv="clr-namespace:DreamBooks.App.Converters"
        xmlns:views="clr-namespace:DreamBooks.App.Views"
        Title="{Binding WindowTitle}" Height="720" Width="1200">
    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
        <conv:InkColorToBrushConverter x:Key="ColorBrush" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenPdfCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <!-- Back after a jump (FR-09); PgUp/PgDn/Home/End are routed in code (not while typing in a field). -->
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Viewport.BackCommand}" />
        <!-- Previous / next mark (FR-102): free in 3a. -->
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Marks.PreviousCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Marks.NextCommand}" />
        <!-- Ctrl + / Ctrl − zoom in and out (FR-06), on the main keys and the numeric keypad. -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomOutCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- Spartan debug panel (spec section 6); looks come in phase 4. -->
        <Expander DockPanel.Dock="Left" IsExpanded="True" ExpandDirection="Right"
                  Header="{x:Static res:Strings.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="{StaticResource PanelWidth}" Padding="8">
                <StackPanel>
                    <!-- Open and page -->
                    <Button Content="{x:Static res:Strings.OpenPdf}" Command="{Binding OpenPdfCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.OpenPdf}" HorizontalAlignment="Left" />

                    <!-- Save (FR-80): the dirty mark is in the window title; the indicator shows while saving (FR-89). -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap}">
                        <Button x:Name="SaveButton" Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Save}" />
                        <Button x:Name="SaveAsButton" Content="{x:Static res:Strings.SaveAs}" Command="{Binding SaveAsCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.SaveAs}" />
                    </StackPanel>
                    <StackPanel x:Name="SavingIndicator" Margin="{StaticResource Gap}"
                                AutomationProperties.Name="{x:Static res:Strings.Saving}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static res:Strings.Saving}" />
                        <!-- Animated only when Windows allows client-area animations (NFR-32). -->
                        <ProgressBar Height="{StaticResource ProgressBarHeight}" Margin="{StaticResource Gap}"
                                     IsIndeterminate="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                                     AutomationProperties.Name="{x:Static res:Strings.Saving}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap}">
                        <Button Content="&lt;" Command="{Binding PreviousPageCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Page}" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0">
                            <Run Text="{x:Static res:Strings.Page}" />
                            <Run Text="{Binding PageNumber, Mode=OneWay}" /> /
                            <Run Text="{Binding PageCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="&gt;" Command="{Binding NextPageCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Page}" />
                    </StackPanel>

                    <!-- Go to page and Back (FR-09): spartan for now, the real placement is phase 4. -->
                    <TextBlock Text="{x:Static res:Strings.GoToPage}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="GoToPageField" InputScope="Number"
                                 MinWidth="{StaticResource GoToPageFieldWidth}" MinHeight="{StaticResource TouchTarget}"
                                 VerticalContentAlignment="Center" Margin="0,0,4,0"
                                 ToolTip="{x:Static res:Strings.GoToPageHint}"
                                 AutomationProperties.Name="{x:Static res:Strings.GoToPage}"
                                 AutomationProperties.HelpText="{x:Static res:Strings.GoToPageHint}"
                                 PreviewKeyDown="OnGoToPageFieldKeyDown" />
                        <Button x:Name="BackButton" Content="{x:Static res:Strings.Back}"
                                Command="{Binding Viewport.BackCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Back}" />
                    </StackPanel>

                    <!-- Marks (FR-102, FR-103): previous / next mark (Alt+Up / Alt+Down) and the list in the left-edge
                         panel; "no other mark" shows here for a moment. Spartan, the real placement is phase 4. -->
                    <TextBlock Text="{x:Static res:Strings.MarksList}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviousMarkButton" Command="{Binding Marks.PreviousCommand}"
                                MinWidth="{StaticResource TouchTarget}" MinHeight="{StaticResource TouchTarget}"
                                AutomationProperties.Name="{x:Static res:Strings.PreviousMark}"
                                ToolTip="{x:Static res:Strings.PreviousMark}">
                            <Path Data="{StaticResource PreviousMarkGlyph}" Stroke="{StaticResource GlyphBrush}"
                                  StrokeThickness="{StaticResource GlyphStrokeThickness}"
                                  Width="{StaticResource GlyphSize}" Height="{StaticResource GlyphSize}" />
                        </Button>
                        <Button x:Name="NextMarkButton" Command="{Binding Marks.NextCommand}"
                                MinWidth="{StaticResource TouchTarget}" MinHeight="{StaticResource TouchTarget}"
                                AutomationProperties.Name="{x:Static res:Strings.NextMark}"
                                ToolTip="{x:Static res:Strings.NextMark}">
                            <Path Data="{StaticResource NextMarkGlyph}" Stroke="{StaticResource GlyphBrush}"
                                  StrokeThickness="{StaticResource GlyphStrokeThickness}"
                                  Width="{StaticResource GlyphSize}" Height="{StaticResource GlyphSize}" />
                        </Button>
                        <Button x:Name="OpenMarksListButton" Content="{x:Static res:Strings.MarksListLabel}"
                                Command="{Binding OpenCommand, ElementName=MarksPanel}"
                                AutomationProperties.Name="{x:Static res:Strings.OpenMarksList}"
                                ToolTip="{x:Static res:Strings.OpenMarksList}" />
                    </StackPanel>
                    <TextBlock x:Name="MarkStatusText" Text="{Binding Marks.StatusText}" TextWrapping="Wrap"
                               Margin="{StaticResource Gap}" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{x:Static res:Strings.MarkStatusLabel}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Marks.StatusText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Journal warning (FR-84): unsaved changes are not being recorded for recovery -->
                    <TextBlock x:Name="JournalWarningText" Text="{Binding JournalWarning}" TextWrapping="Wrap"
                               Margin="{StaticResource Gap}" FontWeight="SemiBold"
                               AutomationProperties.Name="{x:Static res:Strings.JournalWarningLabel}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JournalWarning}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Notice: annotations the app cannot edit, restored changes, journaling off (one line per document) -->
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="{StaticResource Gap}"
                               AutomationProperties.Name="{x:Static res:Strings.NoticeLabel}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Tool -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <RadioButton GroupName="Tool" Content="{x:Static res:Strings.ToolPen}"
                                     IsChecked="{Binding Tools.ActiveTool, Converter={StaticResource EnumMatch}, ConverterParameter=Pen}" />
                        <RadioButton GroupName="Tool" Content="{x:Static res:Strings.ToolEraser}"
                                     IsChecked="{Binding Tools.ActiveTool, Converter={StaticResource EnumMatch}, ConverterParameter=Eraser}" />
                    </StackPanel>

                    <!-- Pressure curve and smoothing -->
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.PressureCurve}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveLinear}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Linear}" />
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveSoft}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Soft}" />
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveFirm}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Firm}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Smoothing}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingOff}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingLight}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingStrong}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Strong}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Base width (mm) -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <TextBlock Text="{x:Static res:Strings.Width}" Style="{StaticResource SectionLabel}" Margin="0" />
                        <TextBlock Text="{Binding Tools.BaseWidthMm, StringFormat={}{0:0.00} mm}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Slider Minimum="0.25" Maximum="5" Value="{Binding Tools.BaseWidthMm}"
                            MinHeight="{StaticResource TouchTarget}"
                            AutomationProperties.Name="{x:Static res:Strings.Width}" />

                    <!-- Colour swatches -->
                    <TextBlock Text="{x:Static res:Strings.Color}" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{x:Static ink:Palette.Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding Converter={StaticResource ColorBrush}}"
                                        Command="{Binding DataContext.Tools.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{x:Static res:Strings.Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="8" Margin="{StaticResource Gap}"
                            Background="{Binding Tools.Color, Converter={StaticResource ColorBrush}}" />

                    <!-- Eraser -->
                    <TextBlock Text="{x:Static res:Strings.EraserMode}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="EraserMode" Content="{x:Static res:Strings.EraseWhole}"
                                     IsChecked="{Binding Tools.EraserMode, Converter={StaticResource EnumMatch}, ConverterParameter=WholeStroke}" />
                        <RadioButton GroupName="EraserMode" Content="{x:Static res:Strings.ErasePartial}"
                                     IsChecked="{Binding Tools.EraserMode, Converter={StaticResource EnumMatch}, ConverterParameter=Partial}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap}">
                        <TextBlock Text="{x:Static res:Strings.EraserSize}" />
                        <TextBlock Text="{Binding Tools.EraserSizeMm, StringFormat={}{0:0.0} mm}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Slider Minimum="2" Maximum="20" Value="{Binding Tools.EraserSizeMm}"
                            MinHeight="{StaticResource TouchTarget}"
                            AutomationProperties.Name="{x:Static res:Strings.EraserSize}" />

                    <!-- Undo / redo -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <Button Content="{x:Static res:Strings.Undo}" Command="{Binding UndoCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Undo}" />
                        <Button Content="{x:Static res:Strings.Redo}" Command="{Binding RedoCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Redo}" />
                    </StackPanel>

                    <!-- Zoom -->
                    <TextBlock Text="{x:Static res:Strings.Zoom}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="-" Command="{Binding ZoomVm.ZoomOutCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Zoom}" />
                        <TextBlock Text="{Binding ZoomVm.Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center"
                                   MinWidth="48" TextAlignment="Center" />
                        <Button Content="+" Command="{Binding ZoomVm.ZoomInCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Zoom}" />
                        <Button Content="{x:Static res:Strings.FitWidth}" Click="OnFitWidthClick"
                                AutomationProperties.Name="{x:Static res:Strings.FitWidth}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <!-- Presses over the document while the left-edge panel is open: outside it they close it (the pen still
             inks), the pen on it never presses its controls (MarksPanel.RoutePress). -->
        <Grid x:Name="PageHost"
              PreviewMouseLeftButtonDown="OnPageHostMouseDown" PreviewTouchDown="OnPageHostTouchDown"
              PreviewStylusDown="OnPageHostStylusDown">
            <views:DocumentView x:Name="DocumentViewer" />
            <!-- Shown until a document is open; the error line stays visible over the page. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{x:Static res:Strings.NoDocument}" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Session}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" Margin="{StaticResource Gap}" />
            </StackPanel>

            <!-- The left-edge panel (UI-04) with the marks list (FR-103): a finger swipe from the left edge, the menu
                 entry; it closes with the close button, Esc, a swipe, a press outside and after a jump. -->
            <views:EdgePanel x:Name="MarksPanel" Title="{x:Static res:Strings.MarksList}"
                             HeaderDetail="{Binding Marks.Count}" HeaderDetailName="{x:Static res:Strings.MarksCountLabel}">
                <views:MarksListView DataContext="{Binding Marks}" />
            </views:EdgePanel>
        </Grid>
    </DockPanel>
</Window>
