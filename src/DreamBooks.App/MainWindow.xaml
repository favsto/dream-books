<ui:FluentWindow x:Class="DreamBooks.App.MainWindow" UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:DreamBooks.App.Resources"
        xmlns:views="clr-namespace:DreamBooks.App.Views"
        Title="{Binding WindowTitle}" Height="720" Width="1200"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenPdfCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <!-- Back after a jump (FR-09); PgUp/PgDn/Home/End are routed in code (not while typing in a field). -->
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Viewport.BackCommand}" />
        <!-- Previous / next mark (FR-102): free in 3a. -->
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Marks.PreviousCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Marks.NextCommand}" />
        <!-- Ctrl + / Ctrl − zoom in and out (FR-06), on the main keys and the numeric keypad. -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomVm.ZoomOutCommand}" />
    </Window.InputBindings>
    <!-- The window shell (UI-01, UI-06): Mica behind everything (a solid brush with transparency effects off, NFR-32,
         ApplyBackdrop), the document filling the whole window, every command in a floating element over it, and the
         transparent title bar laid over its top edge with the save progress line under it. -->
    <Grid x:Name="ShellRoot">
        <Grid x:Name="ShellContent">
            <!-- Presses over the document while the left-edge panel, a toolbar flyout or the main menu is open: outside
                 them they close them (the pen still inks); the pen on the edge panel's sheet never presses its controls
                 (RoutePagePress). -->
            <Grid x:Name="PageHost"
                  PreviewMouseLeftButtonDown="OnPageHostMouseDown" PreviewTouchDown="OnPageHostTouchDown"
                  PreviewTouchMove="OnPageHostTouchMove" PreviewTouchUp="OnPageHostTouchUp"
                  LostTouchCapture="OnPageHostLostTouchCapture" PreviewStylusDown="OnPageHostStylusDown">
                <views:DocumentView x:Name="DocumentViewer" />
                <!-- Shown until a document is open (4b adds the start screen); the error line stays visible over the page. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="{x:Static res:Strings.NoDocument}" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" Margin="{StaticResource Gap}" />
                </StackPanel>

                <!-- The floating toolbar and its option flyouts (UI-02), bottom centre over the document. Only the pill and
                     the open flyout hit-test: the pen around them writes on the page; presses over the document close
                     an open flyout (RoutePagePress). -->
                <views:ToolbarView x:Name="FloatingToolbar" DataContext="{Binding Toolbar}" />

                <!-- Bottom right, left of the rail's strip (UI-05, FR-09, FR-102): the navigation buttons (Back, previous
                     and next mark, the marks' status) above the page indicator chip ("12 / 48 · 125%": tap = go to page,
                     long press or hover = zoom − / + and fit width). Both show and hide with the rail and keep it shown
                     while used (OnRailShownChanged, OnOverlayHoldChanged). The panel has no background: only their
                     surfaces hit-test, so the pen around them writes on the page. -->
                <StackPanel x:Name="NavigationCorner" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="{StaticResource IndicatorChipMargin}">
                    <views:NavigationButtons x:Name="NavButtons" Margin="{StaticResource NavigationButtonsMargin}" />
                    <views:PageIndicatorChip x:Name="IndicatorChip" />
                </StackPanel>

                <!-- Top centre, below the title bar: the search pill (FR-13, FR-105: Ctrl+F or the menu open it, Esc closes
                     it and clears the search, RouteKey; F3 / Shift+F3 anywhere) and under it the notices (FR-84, FR-86).
                     No background: only their surfaces hit-test. -->
                <StackPanel x:Name="TopOverlays" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="{StaticResource TopOverlaysMargin}">
                    <views:SearchPill x:Name="SearchBar" Margin="0" DataContext="{Binding Search}" IsOpen="{Binding IsOpen, Mode=OneWay}" />
                    <views:NoticeBar x:Name="Notices" />
                </StackPanel>

                <!-- The main menu (UI-03): the round button at the top left, below the title bar, and its panel. Under the
                     left-edge panel, which covers it while open. -->
                <views:MainMenuButton x:Name="MainMenu" />

                <!-- The left-edge panel (UI-04) with two tabs: the marks list (FR-103, Ctrl+M) and the page thumbnails
                     (Ctrl+Shift+P). It opens with a finger swipe from the left edge (on the last tab shown) or the menu
                     entries; it closes with the close button, Esc, a swipe, a press outside and after a jump to a mark (a jump
                     to a page leaves it open). -->
                <views:EdgePanel x:Name="MarksPanel" Title="{x:Static res:Strings.MarksList}"
                                 FirstTabHeader="{x:Static res:Strings.MarksList}" FirstTabName="{x:Static res:Strings.MarksTabName}"
                                 SecondTabHeader="{x:Static res:Strings.PagesTab}" SecondTabName="{x:Static res:Strings.PagesTabName}"
                                 HeaderDetail="{Binding Marks.Count}" HeaderDetailNameFormat="{x:Static res:Strings.MarksCountNameFormat}">
                    <views:MarksListView DataContext="{Binding Marks}" />
                    <views:EdgePanel.SecondBody>
                        <views:PagesListView DataContext="{Binding Pages}" />
                    </views:EdgePanel.SecondBody>
                </views:EdgePanel>
            </Grid>
        </Grid>

        <!-- The title bar (UI-06): only the file name, small, with the dirty mark (DocumentTitle; the window's own title
             keeps the app name for the taskbar), and the window buttons, over the document. WPF UI drives the drag area
             and the window buttons through the non-client hit test. For the pen the drag area is client area
             (TitleBarHitTest) and its parts let the pen through (TitleBarPenInput), so the pen writes on the page under
             it; the mouse and fingers drag the window and every pointer presses the buttons as before. -->
        <!-- The two pills behind the title bar (UI-06): the file name with the dirty mark, and the window buttons. They
             never take input (the bar's own parts do) and follow the theme; opaque with transparency effects off. -->
        <views:FloatingSurface x:Name="TitleNamePill" Panel.ZIndex="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Height="{StaticResource TitleBarPillHeight}" Margin="{StaticResource TitleBarPillMargin}"
                               IsHitTestVisible="False" CornerRadius="{StaticResource PillCornerRadius}">
            <TextBlock x:Name="TitleNameText" Text="{Binding DocumentTitle}" VerticalAlignment="Center"
                       Padding="{StaticResource TitleBarNamePadding}" MaxWidth="{StaticResource TitleBarNameMaxWidth}"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GlyphBrush}" />
        </views:FloatingSurface>
        <views:FloatingSurface x:Name="TitleButtonsPill" Panel.ZIndex="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Width="{StaticResource TitleBarButtonsPillWidth}" Height="{StaticResource TitleBarPillHeight}"
                               Margin="{StaticResource TitleBarPillMargin}" IsHitTestVisible="False"
                               CornerRadius="{StaticResource PillCornerRadius}" />
        <ui:TitleBar x:Name="AppTitleBar" VerticalAlignment="Top" Panel.ZIndex="1"
                     Foreground="{DynamicResource GlyphBrush}" ButtonsForeground="{DynamicResource GlyphBrush}"
                     ButtonsBackground="Transparent"
                     Height="{StaticResource TitleBarHeight}"
                     ShowHelp="False" />

        <!-- The save progress line (FR-89) right under the title bar while a save runs; it never takes input. -->
        <views:SaveProgressLine x:Name="SaveLine" Panel.ZIndex="1" Margin="{StaticResource TitleBarClearance}"
                                IsActive="{Binding IsSaving, Mode=OneWay}" />
    </Grid>
</ui:FluentWindow>
