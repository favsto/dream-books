<Window x:Class="DreamBooks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DreamBooks.App.Resources"
        xmlns:ink="clr-namespace:DreamBooks.App.Ink"
        xmlns:conv="clr-namespace:DreamBooks.App.Converters"
        xmlns:views="clr-namespace:DreamBooks.App.Views"
        Title="{x:Static res:Strings.Panel}" Height="720" Width="1200">
    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
        <conv:InkColorToBrushConverter x:Key="ColorBrush" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenPdfCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- Spartan debug panel (spec section 6); looks come in phase 4. -->
        <Expander DockPanel.Dock="Left" IsExpanded="True" ExpandDirection="Right"
                  Header="{x:Static res:Strings.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="{StaticResource PanelWidth}" Padding="8">
                <StackPanel>
                    <!-- Open and page -->
                    <Button Content="{x:Static res:Strings.OpenPdf}" Command="{Binding OpenPdfCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.OpenPdf}" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap}">
                        <Button Content="&lt;" Command="{Binding PreviousPageCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Page}" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0">
                            <Run Text="{x:Static res:Strings.Page}" />
                            <Run Text="{Binding PageNumber, Mode=OneWay}" /> /
                            <Run Text="{Binding PageCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="&gt;" Command="{Binding NextPageCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Page}" />
                    </StackPanel>

                    <!-- Tool -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <RadioButton GroupName="Tool" Content="{x:Static res:Strings.ToolPen}"
                                     IsChecked="{Binding Tools.ActiveTool, Converter={StaticResource EnumMatch}, ConverterParameter=Pen}" />
                        <RadioButton GroupName="Tool" Content="{x:Static res:Strings.ToolEraser}"
                                     IsChecked="{Binding Tools.ActiveTool, Converter={StaticResource EnumMatch}, ConverterParameter=Eraser}" />
                    </StackPanel>

                    <!-- Pressure curve and smoothing -->
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.PressureCurve}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveLinear}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Linear}" />
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveSoft}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Soft}" />
                            <RadioButton GroupName="Curve" Content="{x:Static res:Strings.CurveFirm}"
                                         IsChecked="{Binding Tools.Curve, Converter={StaticResource EnumMatch}, ConverterParameter=Firm}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Smoothing}" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingOff}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingLight}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                            <RadioButton GroupName="Smoothing" Content="{x:Static res:Strings.SmoothingStrong}"
                                         IsChecked="{Binding Tools.Smoothing, Converter={StaticResource EnumMatch}, ConverterParameter=Strong}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Base width (mm) -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <TextBlock Text="{x:Static res:Strings.Width}" Style="{StaticResource SectionLabel}" Margin="0" />
                        <TextBlock Text="{Binding Tools.BaseWidthMm, StringFormat={}{0:0.00} mm}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Slider Minimum="0.25" Maximum="5" Value="{Binding Tools.BaseWidthMm}"
                            MinHeight="{StaticResource TouchTarget}"
                            AutomationProperties.Name="{x:Static res:Strings.Width}" />

                    <!-- Colour swatches -->
                    <TextBlock Text="{x:Static res:Strings.Color}" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{x:Static ink:Palette.Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding Converter={StaticResource ColorBrush}}"
                                        Command="{Binding DataContext.Tools.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{x:Static res:Strings.Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="8" Margin="{StaticResource Gap}"
                            Background="{Binding Tools.Color, Converter={StaticResource ColorBrush}}" />

                    <!-- Eraser -->
                    <TextBlock Text="{x:Static res:Strings.EraserMode}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="EraserMode" Content="{x:Static res:Strings.EraseWhole}"
                                     IsChecked="{Binding Tools.EraserMode, Converter={StaticResource EnumMatch}, ConverterParameter=WholeStroke}" />
                        <RadioButton GroupName="EraserMode" Content="{x:Static res:Strings.ErasePartial}"
                                     IsChecked="{Binding Tools.EraserMode, Converter={StaticResource EnumMatch}, ConverterParameter=Partial}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap}">
                        <TextBlock Text="{x:Static res:Strings.EraserSize}" />
                        <TextBlock Text="{Binding Tools.EraserSizeMm, StringFormat={}{0:0.0} mm}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Slider Minimum="2" Maximum="20" Value="{Binding Tools.EraserSizeMm}"
                            MinHeight="{StaticResource TouchTarget}"
                            AutomationProperties.Name="{x:Static res:Strings.EraserSize}" />

                    <!-- Undo / redo -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionGap}">
                        <Button Content="{x:Static res:Strings.Undo}" Command="{Binding UndoCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Undo}" />
                        <Button Content="{x:Static res:Strings.Redo}" Command="{Binding RedoCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Redo}" />
                    </StackPanel>

                    <!-- Zoom -->
                    <TextBlock Text="{x:Static res:Strings.Zoom}" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="-" Command="{Binding ZoomVm.ZoomOutCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Zoom}" />
                        <TextBlock Text="{Binding ZoomVm.Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center"
                                   MinWidth="48" TextAlignment="Center" />
                        <Button Content="+" Command="{Binding ZoomVm.ZoomInCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Zoom}" />
                        <Button Content="{x:Static res:Strings.FitWidth}" Click="OnFitWidthClick"
                                AutomationProperties.Name="{x:Static res:Strings.FitWidth}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <Grid x:Name="PageHost">
            <views:PageView x:Name="PageViewer" />
            <!-- Shown until a document is open; the error line stays visible over the page. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{x:Static res:Strings.NoDocument}" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" Margin="{StaticResource Gap}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
